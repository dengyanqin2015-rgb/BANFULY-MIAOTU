# Optional server-side placeholders. The production UI uses keys entered by each user.
GEMINI_API_KEY=
VAELO_TEXT_API_KEY=
VAELO_TEXT_MODEL=gemini-3.6-flash
VAELO_DEEP_TEXT_MODEL=gemini-3.1-pro-preview
OPENAI_API_KEY=

# Dedicated image routing for the isolated Vaelo staging site.
# Leave IMAGE_PROVIDER=direct on the existing site.
IMAGE_PROVIDER=direct
VAELO_BASE_URL=https://vaelo.8t.chat
VAELO_API_KEY=
# Platform-specific keys. Both Google image models share the Google key.
# When either platform key is set, the legacy shared key is not used.
VAELO_GPT_IMAGE_API_KEY=
VAELO_GOOGLE_API_KEY=

# Optional outbound proxy. Leave empty on Railway unless explicitly required.
HTTPS_PROXY=
NODE_USE_ENV_PROXY=

# Server security
JWT_SECRET=
ADMIN_INITIAL_PASSWORD=
CORS_ORIGINS=https://your-domain.example

# Persistent storage paths when a Railway volume is mounted at /data
DB_PATH=/data/db.json
REQUEST_LOG_PATH=/data/request-logs.jsonl
IMAGE_ANALYSIS_TEMPLATES_PATH=/data/image-analysis-templates.json

# Existing Railway Volume storage for private asset reference images.
# Optional on Railway: the app automatically uses RAILWAY_VOLUME_MOUNT_PATH/asset-objects.
# Set this only when you want a custom subdirectory. No separate Bucket is required.
ASSET_VOLUME_PATH=/data/asset-objects

# Private S3-compatible object storage for the asset library.
# Railway Storage Buckets expose the fallback variables automatically when linked.
ASSET_BUCKET_NAME=
ASSET_BUCKET_ENDPOINT=
ASSET_BUCKET_REGION=
ASSET_BUCKET_ACCESS_KEY_ID=
ASSET_BUCKET_SECRET_ACCESS_KEY=
ASSET_BUCKET_FORCE_PATH_STYLE=false
ASSET_BUCKET_CORS_ORIGINS=https://your-staging-domain.example
